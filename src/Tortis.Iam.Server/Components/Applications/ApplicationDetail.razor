@using System.Net.Mime
@using OpenIddict.Abstractions

@inject IOpenIddictApplicationManager ApplicationManager;
@inject NavigationManager NavigationManager
@inject IDialogService DialogService;
@inject ILogger<ApplicationDetail> Logger;

<FluentEditForm EditContext="@_editContext" OnValidSubmit="Submit">
    <FluentGrid Justify="JustifyContent.FlexStart">
        <FluentGridItem md="7">
            <FluentStack Orientation="Orientation.Vertical">

                <DataAnnotationsValidator/>
                <FluentTextField @bind-Value="Model.Name" Label="Display Name" Style="width: 100%" />
                <FluentValidationMessage For="() => Model.Name" />
                <FluentSelect Label="Application Type" 
                              Items="@AppTypes"
                              OptionValue="@(type => type.Value)"
                              OptionText="@(type => type.Text)"
                              @bind-SelectedOption="@(_selectedAppType)"
                              @bind-Value="Model.ApplicationType"
                              Width="100%" />
                <FluentSelect Label="Client Type"
                              Items="@ClientTypes"
                              OptionValue="@(type => type.Value)"
                              OptionText="@(type => type.Text)"
                              @bind-SelectedOption="@(_selectedClientType)"
                              @bind-Value="Model.ClientType"
                              Width="100%" />
                <FluentTextField @bind-Value="Model.RedirectUris" Label="Redirect URIs" Style="width: 100%" />

                <FluentStack Orientation="Orientation.Horizontal" Width="100%" HorizontalAlignment="HorizontalAlignment.Left" >
                    <h4>Permissions (Allowed scopes)</h4>
                    <FluentStack Orientation="Orientation.Horizontal" Width="100%" HorizontalAlignment="HorizontalAlignment.Right" >
                        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="AddPermission">Add Permission</FluentButton>
                    </FluentStack>                
                </FluentStack>

                <FluentDataGrid Items="@Model.Scopes.AsQueryable()" Style="width: 100%;" RowSize="DataGridRowSize.Large">
                    <PropertyColumn Title="Scope" Property="arg => arg"></PropertyColumn>
                    <TemplateColumn Title="Actions" Context="scopesContext" Width="120px">
                            <FluentButton OnClick="@(() => { })">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Neutral"></FluentIcon>
                            </FluentButton>
                            <FluentButton>
                                <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error"></FluentIcon>
                            </FluentButton>
                    </TemplateColumn>
                </FluentDataGrid>
                
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Loading="@_saving" Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saveButtonDisabled">Save</FluentButton>
                    <FluentButton OnClick="Discard" Disabled="@_saveButtonDisabled">Discard</FluentButton>
                </FluentStack>
            </FluentStack>
            
        </FluentGridItem>
        <FluentGridItem md="5">
            <FluentStack Orientation="Orientation.Vertical">
                <FluentLabel Weight="FontWeight.Bold">Allowed Grant Types</FluentLabel>
                <FluentCheckbox Label="Auth Code" @bind-Value="Model.AllowAuthCode" />
                <FluentCheckbox Label="Require Proof Key for Code Exchange" @bind-Value="Model.RequiredProofKeyForCodeExchange" Disabled="@(!Model.AllowAuthCode)" />
                <FluentCheckbox Label="Client Credentials" @bind-Value="Model.AllowClientCredentials"/>
                <FluentCheckbox Label="Refresh Token" @bind-Value="Model.AllowRefreshToken"/>

                <FluentLabel Weight="FontWeight.Bold">Allowed Response Types</FluentLabel>
                <FluentCheckbox Label="code" @bind-Value="Model.AllowAuthCode" ReadOnly="true"/>
                <FluentCheckbox Label="id_token" @bind-Value="Model.AllowIdToken"/>
                <FluentCheckbox Label="code id_token" @bind-Value="Model.AllowCodeIdToken"/>

                <FluentLabel Weight="FontWeight.Bold">Allowed Open Id Connect Scopes</FluentLabel>
                <FluentCheckbox Label="email" @bind-Value="Model.AllowEmail"/>
                <FluentCheckbox Label="profile" @bind-Value="Model.AllowProfile"/>
                <FluentCheckbox Label="roles" @bind-Value="Model.AllowRoles"/>
                <FluentCheckbox Label="address" @bind-Value="Model.AllowAddress"/>
                <FluentCheckbox Label="phone" @bind-Value="Model.AllowPhone"/>
            </FluentStack>
        </FluentGridItem>
    </FluentGrid>
</FluentEditForm>

@code {
    static readonly Option<string>[] AppTypes =
    {
        new() { Value = OpenIddictConstants.ApplicationTypes.Web, Text = "Web (e.g. SPAs, Server Side Web Apps, SaaS Apps, APIs)"},
        new() { Value = OpenIddictConstants.ApplicationTypes.Native, Text = "Native (e.g. Desktop Apps, Mobile Apps)" }
    };

    static readonly Option<string>[] ClientTypes =
    {
        new() { Value = OpenIddictConstants.ClientTypes.Public, Text = "Public (e.g. SPAs, Desktop Apps, Mobile Apps)"},
        new() { Value = OpenIddictConstants.ClientTypes.Confidential, Text = "Confidential (e.g. Server Side Web Apps, APIs)" }
    };

    [Parameter] 
    public required ApplicationViewModel Model { get; init; }
    [Parameter]
    public required Func<Task> OnSubmit { get; init; }
    
    Option<string>? _selectedAppType;
    Option<string>? _selectedClientType;

    bool _saveButtonDisabled;
    bool _saving;
    EditContext _editContext;
    ApplicationViewModel _undo;
    
    protected override void OnInitialized()
    {
        _saveButtonDisabled = true;
        _selectedAppType = AppTypes.FirstOrDefault(appType => appType.Value == Model.ApplicationType) ?? AppTypes[0];
        _selectedClientType = ClientTypes.FirstOrDefault(clientType => clientType.Value == Model.ClientType) ?? ClientTypes[0];

        _editContext = new EditContext(Model);
        _editContext.OnFieldChanged += (_, _) => _saveButtonDisabled = false;

        _undo = Model.Clone();
    }
    
    async Task Submit()
    {
        try
        {
            await OnSubmit();
            _saveButtonDisabled = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, ex.Message);
            await DialogService.ShowErrorAsync(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    async Task AddPermission()
    {
        var dialog = await DialogService.ShowDialogAsync<AddPermissionDialog>(Model.Scopes, new DialogParameters
        {
            Width = "75%"
        });
        var result = await dialog.Result;
        if (result.Data is string[] selectedScopes)
            Model.Scopes.AddRange(selectedScopes);
    }

    void Discard()
    {
        Model.Name = _undo.Name;
        Model.ApplicationType = _undo.ApplicationType;
        Model.ClientType = _undo.ClientType;
        Model.RedirectUris = _undo.RedirectUris;
        Model.AllowAuthCode = _undo.AllowAuthCode;
        Model.RequiredProofKeyForCodeExchange = _undo.RequiredProofKeyForCodeExchange;
        Model.AllowClientCredentials = _undo.AllowClientCredentials;
        Model.AllowRefreshToken = _undo.AllowRefreshToken;
        Model.AllowIdToken = _undo.AllowIdToken;
        Model.AllowCodeIdToken = _undo.AllowCodeIdToken;
        Model.AllowEmail = _undo.AllowEmail;
        Model.AllowProfile = _undo.AllowProfile;
        Model.AllowRoles = _undo.AllowRoles;
        Model.AllowAddress = _undo.AllowAddress;
        Model.AllowPhone = _undo.AllowPhone;
        Model.Scopes.Clear();
        _undo.Scopes.ForEach(s => Model.Scopes.Add(new String(s)));
        _saveButtonDisabled = true;
    }

}
