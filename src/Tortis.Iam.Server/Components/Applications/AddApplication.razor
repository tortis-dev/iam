@page "/add-application"

@using OpenIddict.Abstractions

@inject IOpenIddictApplicationManager ApplicationManager;
@inject NavigationManager NavigationManager

<h3>Add Application</h3>

<ApplicationDetail Model="_inputModel" OnSubmit="OnSubmit" />

@code {
    InputModel _inputModel = new();

    async Task OnSubmit()
    {
        var app = _inputModel.ToApplicationDescriptor();
        app.ClientId = Guid.NewGuid().ToString();
        app.ClientSecret = _inputModel.ClientType.Equals(OpenIddictConstants.ClientTypes.Confidential) ? Guid.NewGuid().ToString() : null;
        
        await ApplicationManager.CreateAsync(app);
        NavigationManager.NavigateTo("/applications");
    }
}
