@page "/applications/{id:guid}"

@using System.Security.Cryptography
@using OpenIddict.Core
@using OpenIddict.EntityFrameworkCore.Models

@inject OpenIddictApplicationManager<OpenIddictEntityFrameworkCoreApplication<Guid>> ApplicationManager;
@inject NavigationManager NavigationManager;

<PageTitle>IAM: @_model.Name</PageTitle>
<h3>Edit Application</h3>

<FluentStack Orientation="Orientation.Vertical" >
  <FluentInputLabel>Client Id</FluentInputLabel>
  <FluentLabel>@_model.ClientId</FluentLabel>
  <FluentInputLabel>Client Secret</FluentInputLabel>
  <FluentLabel>@_model.ClientSecret</FluentLabel>
  <ApplicationDetail Model="@_model" OnSubmit="OnSubmit" />
</FluentStack>
@code {
    
    [Parameter]
    public required Guid Id { get; init; }

    ApplicationViewModel _model = new();

    OpenIddictEntityFrameworkCoreApplication<Guid>? _application;

    protected override async Task OnInitializedAsync()
    {
        _application = await ApplicationManager.FindByIdAsync(Id.ToString());

        if (_application is null)
            NavigationManager.NavigateTo("/not-found/404");

        // Will never hit this if it is null, so using null forgiving operator to make the compiler happy.
        _model = _application!.ToViewModel();
        _model.ClientId = _application.ClientId;
    }

    async Task OnSubmit()
    {
        if (_application is not null)
        {
            var descriptor = _model.ToApplicationDescriptor();
            if (_model.AllowClientCredentials && string.IsNullOrWhiteSpace(_model.ClientSecret))
            {
              var hmac = new HMACSHA256();
              descriptor.ClientSecret = Convert.ToBase64String(hmac.Key);
            }
            
            await ApplicationManager.UpdateAsync(_application, descriptor);
        }
    }
}