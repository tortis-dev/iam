@page "/roles"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tortis.Iam.Server.Data

@inject IamDbContext DbContext;
@inject NavigationManager Navigation;

@attribute [Authorize]

<PageTitle>Roles</PageTitle>
<h3>Roles</h3>
<FluentButton Appearance="Appearance.Accent">New Role</FluentButton>
<FluentDataGrid Items="_roles">
    <PropertyColumn Property="p => p.Name" Title="Role Name" Sortable="true" IsDefaultSortColumn="true" />
</FluentDataGrid>


@code {
    IQueryable<IdentityRole<Guid>> _roles;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _roles = DbContext.Roles;
    }
}