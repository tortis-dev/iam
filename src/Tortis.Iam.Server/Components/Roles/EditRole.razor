@page "/roles/{id:guid}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tortis.Iam.Server.Data

@inject RoleManager<IamRole> RoleManager
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]

<PageTitle>Edit Role: @Model.Name</PageTitle>
<h3>Edit Role</h3>

@if (isLoading)
{
    <div>Loading...</div>
}
else
{
    <FluentEditForm Model="Model" OnValidSubmit="Submit">
        <DataAnnotationsValidator/>
        <FluentStack Orientation="Orientation.Vertical">
            <FluentTextField @bind-Value="Model.Name" Label="Role Name"></FluentTextField>
            <FluentValidationMessage For="() => Model.Name"></FluentValidationMessage>
            <FluentTextField @bind-Value="Model.Description" Label="Description"></FluentTextField>
            <FluentStack Orientation="Orientation.Horizontal">
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Save</FluentButton>
                <FluentButton OnClick="@(() => NavigationManager.NavigateTo("/roles"))">Cancel</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentEditForm>
}

@code {
    [Parameter]
    public required Guid Id { get; init; }
    
    private sealed class InputModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }
    };
    
    InputModel Model { get; set; } = new();
    bool isLoading = true;
    IamRole? _role;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        _role = await RoleManager.FindByIdAsync(Id.ToString());
        
        if (_role is null)
        {
            NavigationManager.NavigateTo("/roles");
            return;
        }
        
        Model.Name = _role.Name ?? string.Empty;
        Model.Description = _role.Description;
        isLoading = false;
    }

    async Task Submit()
    {
        if (_role is null) return;
        
        _role.Name = Model.Name;
        _role.Description = Model.Description;
        _role.NormalizedName = Model.Name.ToUpperInvariant();
        _role.ModifiedOn = DateTimeOffset.Now;
        _role.ModifiedBy = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
        
        var result = await RoleManager.UpdateAsync(_role);
        
        if (!result.Succeeded)
            return;
        
        NavigationManager.NavigateTo("/roles");
    }
}