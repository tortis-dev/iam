@page "/add-role"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Tortis.Iam.Server.Data

@inject RoleManager<IamRole> RoleManager
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]

<PageTitle>Add Role</PageTitle>
<h3>Add Role</h3>

<FluentEditForm Model="Model" OnValidSubmit="Submit">
    <DataAnnotationsValidator/>
    <FluentStack Orientation="Orientation.Vertical">
        <FluentTextField @bind-Value="Model.Name" Label="Role Name"></FluentTextField>
        <FluentValidationMessage For="() => Model.Name"></FluentValidationMessage>
        
        <FluentStack Orientation="Orientation.Horizontal">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Save</FluentButton>
            <FluentButton OnClick="@(() => NavigationManager.NavigateTo("/roles"))">Cancel</FluentButton>
        </FluentStack>
    </FluentStack>
</FluentEditForm>

@code {
    private sealed class InputModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;
    };
    
    InputModel Model { get; } = new();

    async Task Submit()
    {
        var role = new IamRole(Model.Name)
        {
            Id = Ulid.NewUlid().ToGuid(),
            NormalizedName = Model.Name.ToUpperInvariant(),
            CreatedOn = DateTimeOffset.Now,
            CreatedBy = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier)!
        };
        
        var result = await RoleManager.CreateAsync(role);
        
        if (!result.Succeeded)
            return;
        
        NavigationManager.NavigateTo("/roles");
    }
}