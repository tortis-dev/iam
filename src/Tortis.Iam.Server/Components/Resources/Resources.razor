@page "/resources"
@rendermode InteractiveServer

@inject IamResourceManager ResourceManager;

@inject NavigationManager Navigation;

<PageTitle>API Resources</PageTitle>
<h3>API Resources</h3>
<p>
    APIs are called by Applications. Resource cannot authenticate. They simply validate tokens are valid.
</p>
<FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/add-resource"))">New API Resource</FluentButton>
<FluentDataGrid Items="ResourceManager.ApiResources" Pagination="@_pagination">
    <PropertyColumn Property="p => p.Urn" Title="Urn" Sortable="true" IsDefaultSortColumn="true" />
    <PropertyColumn Property="p => p.Description" Title="Description" Sortable="true" />
    <TemplateColumn Title="Actions" Width="120px">
        <FluentButton OnClick="@(() => Navigation.NavigateTo($"applications/{context.Id}"))">
            <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Neutral"></FluentIcon>
        </FluentButton>
        <FluentButton>
            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error"></FluentIcon>
        </FluentButton>
    </TemplateColumn>
</FluentDataGrid>
<FluentPaginator State="@_pagination" />

@code {
    readonly PaginationState _pagination = new() { ItemsPerPage = 10 } ;
}