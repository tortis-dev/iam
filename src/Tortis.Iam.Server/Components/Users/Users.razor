@page "/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Tortis.Iam.Server.Data

@inject IamDbContext IamDbContext;
@inject NavigationManager Navigation;

@attribute [Authorize]

<PageTitle>Users</PageTitle>
<h3>Users</h3>
<FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/add-user"))">New User</FluentButton>
<FluentDataGrid Items="_users">
    <PropertyColumn Property="p => p.UserName" Title="Username" Sortable="true" IsDefaultSortColumn="true" />
    <PropertyColumn Property="p => p.Email" Title="Email" Sortable="true" />
    <TemplateColumn Title="2FA" Sortable="true">
            @if(context.TwoFactorEnabled)
            {
                <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Success" />
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="Color.Error" />
            }
    </TemplateColumn>
    <TemplateColumn Title="Locked" Sortable="true">
        @if(context.AccountLocked)
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.LockClosed())" Color="Color.Error" Title="Account is locked." />
        }
        else
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.LockOpen())" Color="Color.Success" Title="Account is unlocked." />
        }
    </TemplateColumn>
    <TemplateColumn Title="Actions">
        <FluentButton OnClick="@(() => Navigation.NavigateTo($"users/{context.Id}"))">
            <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Neutral"></FluentIcon>
        </FluentButton>
        <FluentButton>
            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error"></FluentIcon>
        </FluentButton>
    </TemplateColumn>
</FluentDataGrid>

