@implements IDialogContentComponent

<FluentStack Orientation="Orientation.Horizontal">
<FluentTextField Label="New Password" @bind-Value="@_newPassword"></FluentTextField>
<FluentButton OnClick="Generate">Generate</FluentButton>
</FluentStack>
<p style="margin-top: 15px;">
    Make a note of the new password. It will never be displayed again.
</p>
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@ResetAsync">Reset</FluentButton>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelAsync">Cancel</FluentButton>
</FluentDialogFooter>
@code {
    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;
    
    string? _newPassword;

    async Task ResetAsync()
    {
        await Dialog.CloseAsync(_newPassword);
    }

    async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }

    void Generate()
    {
        _newPassword = PasswordGenerator.Generate(12);
    }

}