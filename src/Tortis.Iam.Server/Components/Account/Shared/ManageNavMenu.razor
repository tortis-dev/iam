@using Microsoft.AspNetCore.Identity
@using Tortis.Iam.Server.Data

@inject SignInManager<IamUser> SignInManager


<FluentNavMenu Width="350">
    <FluentNavLink Icon="@(new Icons.Filled.Size24.Person())" Href="Account/Manage" Match="NavLinkMatch.All">Profile</FluentNavLink>
    <FluentNavLink Icon="@(new Icons.Filled.Size24.Mail())" Href="Account/Manage/Email">Email</FluentNavLink>
    <FluentNavLink Icon="@(new Icons.Filled.Size24.Password())" Href="Account/Manage/ChangePassword">Password</FluentNavLink>
    @if (_hasExternalLogins)
    {
        <FluentNavLink Icon="@(new Icons.Regular.Size24.Guardian())" Href="Account/Manage/ExternalLogins">External logins</FluentNavLink>
    }
    <FluentNavLink Icon="@(new Icons.Filled.Size24.Shield())" Href="Account/Manage/TwoFactorAuthentication">Two-factor authentication</FluentNavLink>
    <FluentNavLink Icon="@(new Icons.Filled.Size24.Database())" Href="Account/Manage/PersonalData">Personal data</FluentNavLink>
</FluentNavMenu>


@code {
    private bool _hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        _hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

}