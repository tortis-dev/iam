@inherits LayoutComponentBase

<div style="width: 100vw; height: 100vh; background: no-repeat url('turtles.jpg'); background-size: cover">
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" Style="height: 100vh; width: 100vw" >
        <FluentGrid Justify="JustifyContent.Center">
            <FluentGridItem xm="12" sm="6" md="8" lg="6">
                <FluentCard>
                    @Body
                </FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </FluentStack>
</div>