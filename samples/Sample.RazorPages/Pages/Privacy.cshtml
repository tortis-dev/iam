@page
@using Microsoft.AspNetCore.Authorization
@model PrivacyModel
@attribute [Authorize]

@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<p>Is an Administrator: @User.IsInRole("Administrators")</p>
<p>Is a Security Administrator: @User.IsInRole("Security Administrators")</p>
<table>
    @{
        foreach (var claim in User.Claims)
        {
            <tr>
                <td>@claim.Type</td>
                <td>@claim.Value</td>
            </tr>
        }
    }
</table>